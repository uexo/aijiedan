# Lianvo 环境变量示例（占位密钥位）
# 复制为 .env 并按需填写；.env 已被 .gitignore 忽略，不会进版本库。
# 启动：LIANVO_DB_DSN='...' ./lianvo   （空 DSN = 内存模式，零依赖演示）

# ───────────────────────── 存储 ─────────────────────────
# 设置 LIANVO_DB_DSN 即接 MySQL（库名 lianvo @ your-db-host:3306）。
# 留空 = 内存模式（演示/冒烟零依赖）。
LIANVO_DB_DSN=root:your_db_password@tcp(your-db-host:3306)/lianvo?charset=utf8mb4&parseTime=true
# db_reset.py 重置库用（仅本地管理脚本读取）
LIANVO_DB_HOST=your-db-host
LIANVO_DB_PORT=3306
LIANVO_DB_USER=root
LIANVO_DB_PASSWORD=your_db_password
LIANVO_DB_NAME=lianvo

# ─────────────────── 资金通道：微信支付 v3（真实方案2） ───────────────────
# 设置 LIANVO_WECHAT_MCHID 即启用微信真实通道；缺此项则退化为 stub（不接真实资金）。
# 以下五项齐全 live=true：担保交易下单 / 分账 / 退款 才真正发起 HTTPS 请求。
LIANVO_WECHAT_MCHID=
LIANVO_WECHAT_APPID=
LIANVO_WECHAT_SERIAL=        # 商户 API 证书序列号
LIANVO_WECHAT_KEY_PEM=       # 商户私钥（PKCS8/PKCS1 PEM；多行请用文件或字面换行）
LIANVO_WECHAT_APIV3_KEY=     # APIv3 密钥，用于支付回调报文 AES-256-GCM 解密
LIANVO_WECHAT_NOTIFY=        # 支付结果通知地址，如 https://your.domain/api/v1/payments/notify

# ─────────────────── 实名认证 KYC（真实方案2） ───────────────────
# LIANVO_KYC_PROVIDER=real 启用真实厂商；留空 = mock（提交即自动通过，演示用）。
# 真实模式下以下两项齐全才 live；否则退回 pending 受理（不自动通过）。
LIANVO_KYC_PROVIDER=mock
LIANVO_KYC_APIKEY=
LIANVO_KYC_BASEURL=          # 如 https://kyc.vendor.com/v1

# ─────────────────── IM 即时通讯（可选，默认内存 stub） ───────────────────
LIANVO_IM_PROVIDER=          # 填 tencent 启用腾讯云 IM
LIANVO_TENCENT_IM_APPID=
LIANVO_TENCENT_IM_SECRET=
LIANVO_TENCENT_IM_ADMIN=
LIANVO_TENCENT_IM_API=
LIANVO_IM_MODERATOR=         # 填 tencent 启用腾讯云内容审核

# ─────────────────── 通知（可选，默认仅站内信落库） ───────────────────
# 真实邮件：填 SMTP 五项；或 LIANVO_NOTIFY_EMAIL=1 用 stub 骨架。
LIANVO_SMTP_HOST=
LIANVO_SMTP_PORT=465
LIANVO_SMTP_USER=
LIANVO_SMTP_PASS=
LIANVO_SMTP_FROM=
LIANVO_NOTIFY_EMAIL=0
# 真实短信：填 SMS 网关；或 LIANVO_NOTIFY_SMS=1 用 stub 骨架。
LIANVO_SMS_GATEWAY=
LIANVO_SMS_KEYID=
LIANVO_SMS_KEYSECRET=
LIANVO_SMS_TPL=
LIANVO_NOTIFY_SMS=0

# ─────────────────── AI 能力（语义匹配 + 需求澄清，可选，默认零依赖 stub） ───────────────────
# 全部留空 = 平台以「规则化离线兜底」运行（词袋语义 + 正则澄清），无需任何外部 Key 即可跑通演示。
# 填下列变量即从「保底版」升级为「真实大模型版」，调用失败/超时自动回退保底版，绝不挂。

# 1) 需求澄清（P1-2）：自然语言 → 多轮对话 → 结构化 spec
LIANVO_LLM_API_KEY=          # 如 sk-xxx（OpenAI）/ 或 DeepSeek、通义等 OpenAI 兼容服务的 Key
LIANVO_LLM_BASE_URL=         # 兼容 /v1/chat/completions 的端点；留空默认 https://api.openai.com/v1
LIANVO_LLM_MODEL=            # 留空默认 gpt-4o-mini

# 2) 语义匹配（M2）：任务文描 ↔ 接单方技能画像 的稠密向量召回
LIANVO_EMBEDDING_MODE=       # 填 llm 启用真实向量；留空 = 词袋保底
LIANVO_EMBEDDING_API=        # 兼容 /embeddings 的端点（OpenAI / Ollama / 自建）；必填才生效
LIANVO_EMBEDDING_KEY=        # 如需鉴权
LIANVO_EMBEDDING_MODEL=      # 如 text-embedding-3-small

# 3) 联网代理（中国大陆访问外部 LLM 常用）：Clash / 公司代理出口
#    也可用系统环境变量 HTTP_PROXY / HTTPS_PROXY / NO_PROXY（自动读取）。
#    以下变量优先级最高，显式覆盖系统代理。
LIANVO_AI_PROXY=             # 如 http://127.0.0.1:7890

# ─────────────────── 语义匹配 Embedder（M2，可插拔） ───────────────────
# 留空 = 词袋余弦（零依赖保底，行为与 M1 完全一致）。
# 设 llm 且配 LIANVO_EMBEDDING_API 即走 OpenAI 兼容 /embeddings（稠密向量，提升中文近义召回）；
# 未配置/调用失败时自动回退词袋，召回不挂。支持 OpenAI 官方 / Ollama / 自建向量服务。
LIANVO_EMBEDDING_MODE=        # 留空 或 bag-of-words / llm
LIANVO_EMBEDDING_API=         # 如 https://api.openai.com/v1 或 http://localhost:11434/v1
LIANVO_EMBEDDING_KEY=
LIANVO_EMBEDDING_MODEL=       # 如 text-embedding-3-small / nomic-embed-text

