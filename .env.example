# HiveGet 环境变量示例（占位密钥位）
# 复制为 .env 并按需填写；.env 已被 .gitignore 忽略，不会进版本库。
# 启动：HIVEGET_DB_DSN='...' ./hiveget   （空 DSN = 内存模式，零依赖演示）

# ───────────────────────── 存储 ─────────────────────────
# 设置 HIVEGET_DB_DSN 即接 MySQL（库名 hiveget @ your-db-host:3306）。
# 留空 = 内存模式（演示/冒烟零依赖）。
HIVEGET_DB_DSN=root:your_db_password@tcp(your-db-host:3306)/hiveget?charset=utf8mb4&parseTime=true
# db_reset.py 重置库用（仅本地管理脚本读取）
HIVEGET_DB_HOST=your-db-host
HIVEGET_DB_PORT=3306
HIVEGET_DB_USER=root
HIVEGET_DB_PASSWORD=your_db_password
HIVEGET_DB_NAME=hiveget

# ─────────────────── 资金通道：微信支付 v3（真实方案2） ───────────────────
# 设置 HIVEGET_WECHAT_MCHID 即启用微信真实通道；缺此项则退化为 stub（不接真实资金）。
# 以下五项齐全 live=true：担保交易下单 / 分账 / 退款 才真正发起 HTTPS 请求。
HIVEGET_WECHAT_MCHID=
HIVEGET_WECHAT_APPID=
HIVEGET_WECHAT_SERIAL=        # 商户 API 证书序列号
HIVEGET_WECHAT_KEY_PEM=       # 商户私钥（PKCS8/PKCS1 PEM；多行请用文件或字面换行）
HIVEGET_WECHAT_APIV3_KEY=     # APIv3 密钥，用于支付回调报文 AES-256-GCM 解密
HIVEGET_WECHAT_NOTIFY=        # 支付结果通知地址，如 https://your.domain/api/v1/payments/notify

# ─────────────────── 实名认证 KYC（真实方案2） ───────────────────
# HIVEGET_KYC_PROVIDER=real 启用真实厂商；留空 = mock（提交即自动通过，演示用）。
# 真实模式下以下两项齐全才 live；否则退回 pending 受理（不自动通过）。
HIVEGET_KYC_PROVIDER=mock
HIVEGET_KYC_APIKEY=
HIVEGET_KYC_BASEURL=          # 如 https://kyc.vendor.com/v1

# ─────────────────── IM 即时通讯（可选，默认内存 stub） ───────────────────
HIVEGET_IM_PROVIDER=          # 填 tencent 启用腾讯云 IM
HIVEGET_TENCENT_IM_APPID=
HIVEGET_TENCENT_IM_SECRET=
HIVEGET_TENCENT_IM_ADMIN=
HIVEGET_TENCENT_IM_API=
HIVEGET_IM_MODERATOR=         # 填 tencent 启用腾讯云内容审核

# ─────────────────── 通知（可选，默认仅站内信落库） ───────────────────
# 真实邮件：填 SMTP 五项；或 HIVEGET_NOTIFY_EMAIL=1 用 stub 骨架。
HIVEGET_SMTP_HOST=
HIVEGET_SMTP_PORT=465
HIVEGET_SMTP_USER=
HIVEGET_SMTP_PASS=
HIVEGET_SMTP_FROM=
HIVEGET_NOTIFY_EMAIL=0
# 真实短信：填 SMS 网关；或 HIVEGET_NOTIFY_SMS=1 用 stub 骨架。
HIVEGET_SMS_GATEWAY=
HIVEGET_SMS_KEYID=
HIVEGET_SMS_KEYSECRET=
HIVEGET_SMS_TPL=
HIVEGET_NOTIFY_SMS=0

# ─────────────────── AI 澄清（P1-2，可选） ───────────────────
HIVEGET_LLM_API_KEY=
HIVEGET_LLM_BASE_URL=
HIVEGET_LLM_MODEL=
